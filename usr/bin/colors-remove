#!/bin/bash

main(){
    # pre {{{
    case "$1" in
        -h|--help)
            echo "Usage: $(basename "$0") [OPTIONS] < input"
            echo "Remove ANSI color and escape codes from standard input."
            echo
            echo "Options:"
            echo "  -h, --help    Display this help message and exit"
            exit 0
            ;;
    esac
    # }}}

    if [[ ! -t 0 ]] ; then
        sed -r -e "s/\x1B\[([0-9]{1,2}(;[0-9]{1,2})?)?[mGK]//g" -e "s/\x0f//g" </dev/stdin 2>/dev/null || true

    fi

}

#
#  MAIN
#
main "$@"

# vim: set foldmethod=marker :
