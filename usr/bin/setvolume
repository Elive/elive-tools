#!/bin/bash
SOURCE="$0"
source /usr/lib/elive-tools/functions
EL_REPORTS="1"
#el_make_environment
. gettext.sh
TEXTDOMAIN="elive-tools"
export TEXTDOMAIN


#export NOREPORTS=1

conf_volume_set(){
    local volume_actual

    if [[ "$audio_subsystem" != "alsa" ]] ; then
        return 0
    fi

    if [[ -n "$1" ]] ; then
        volume_actual="$1"
    else
        volume_actual="$( get_volume )"
    fi

    if [[ -n "$volume_actual" ]] && [[ "$volume_actual" != 0 ]] ; then
        echo -e "volume_before=\"$volume_actual\"" > "$conf"
    fi
}
conf_volume_get(){
    if [[ "$audio_subsystem" != "alsa" ]] ; then
        return 0
    fi

    source "$conf" 2>/dev/null
}


#===  FUNCTION  ================================================================
#          NAME:  get_meter
#   DESCRIPTION:  prints the meter that we should use for modify volumes
#    PARAMETERS:  -
#       RETURNS:  meter name in a string value
#===============================================================================
get_meter(){
    local candidate

    case "$audio_subsystem" in
        pipewire)
            meter="PipeWire"
            return 0
            ;;
        pipewire-pulse|pulseaudio)
            meter="PulseAudio"
            return 0
            ;;
    esac

    if [[ "$EL_DEBUG" -gt 2 ]] ; then
        el_check_variables "list"
    fi

    if [[ -z "$list" ]] ; then
        list="$( amixer scontrols )"
        unset meter
    fi

    # Master should stay at Max volume if possible to avoid distortions; DAC is for special cards like ice1712
    for candidate in PCM Front Wave Center IEC958 Headphone Speaker PulseAudio Master DAC ; do
        if [[ "$list" = *"'${candidate}'"* ]] ; then
            meter="$candidate"
            if set_volume_alsa "2%-" 2>/dev/null && set_volume_alsa "2%+" 2>/dev/null ; then
                break
            else
                unset meter
            fi
        fi
    done

    # checks
    if [[ -z "$meter" ]] ; then

        if ((is_already_configured)) ; then
            # debug
            el_error "No meters found to configure volumes, is your audio card working?:\nset_volume result with PCM,0:  $(amixer -q set PCM "2%-" 2>&1 )\nset_volume result with PCM,1:  $(amixer -q set PCM,1 "2%-" 2>&1 )\nset_volume result with Master,0:  $(amixer -q set Master "2%-" 2>&1 )\n\nlist (amixer scontrols):\n$list\namixer scontrols:  $(amixer scontrols)\n|$(cat /proc/asound/cards)|\ncat ~./.asoundrc :\n$(cat "$HOME/.asoundrc" )\n\ntrying to reconfigure with more debug:\n$( export IGNORE_LOCK=1 EL_DEBUG=3 ; audio-configurator --quiet --smart --auto --no-messages 2>&1 )"

            # notify user
            if ! ((is_quiet_mode)) ; then
                el_notify "normal" "mixer" "$( eval_gettext "Audio card unknown" )" "$( eval_gettext "There's no audio playback channel found in your volumes. You must reconfigure your audio card from your applications menu." )"
            fi

            # always show to the user configure his audio card because he needs it working!
            if grep -Fqs "boot=live" /proc/cmdline ; then
                audio-configurator
            fi

        else
            # update the tool first, in case that there's fixes
            NOREPORTS=1 el_package_upgrade_fast 180 force "elive-tools"

            export is_already_configured=1

            if grep -Fqs "boot=live" /proc/cmdline ; then
                audio-configurator --quiet --smart --auto --no-messages
            else
                audio-configurator
            fi

        fi
    fi
}

#===  FUNCTION  ================================================================
#          NAME:  get_volume
#   DESCRIPTION:  get the actual volume status
#    PARAMETERS:  -
#       RETURNS:  volume percentage in a simple integer value
#===============================================================================
get_volume(){
    local volume

    case "$audio_subsystem" in
        pipewire)
            volume="$( LC_ALL=C wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '/Volume:/ {printf "%.0f\n", $2 * 100}' )"
            if [[ -n "$volume" ]] ; then
                echo "$volume"
            else
                el_warning "unable to get actual volume with pipewire: $( wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>&1 )"
            fi
            return 0
            ;;
        pipewire-pulse|pulseaudio)
            if command -v pulsemixer >/dev/null 2>&1 ; then
                volume="$( pulsemixer --get-volume 2>/dev/null | awk '{print $1}' )"
            elif command -v pactl >/dev/null 2>&1 ; then
                volume="$( LC_ALL=C pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oE '[0-9]+%' | head -1 | tr -d '%' )"
            fi
            if [[ -n "$volume" ]] ; then
                echo "$volume"
            else
                el_warning "unable to get actual volume with $audio_subsystem"
            fi
            return 0
            ;;
    esac

    if [[ "$EL_DEBUG" -gt 2 ]] ; then
        el_check_variables "meter|list"
    fi

    if [[ "$list" = *"'$meter',1"* ]] ; then
        # stereo
        volume="$( LC_ALL="$EL_LC_EN" amixer sget "${meter},0" 2>/dev/null | LC_ALL="$EL_LC_EN" grep -E "(Playback:|Right:|Mono:)" | psort -- -p "Playback:" -p "Right:" -p "Mono:" | tr ' ' '\n' | LC_ALL="$EL_LC_EN" grep -F "%" | sed -e 's|\[||g' -e 's|\]||g' -e 's|%||g' | LC_ALL="$EL_LC_EN" grep -E "[[:digit:]]*" | head -1 )"
    else
        # mono
        volume="$( LC_ALL="$EL_LC_EN" amixer get "${meter}" 2>/dev/null | LC_ALL="$EL_LC_EN" grep -E "(Playback:|Right:|Mono:)" | psort -- -p "Playback:" -p "Right:" -p "Mono:" | tr ' ' '\n' | LC_ALL="$EL_LC_EN" grep -F "%" | sed -e 's|\[||g' -e 's|\]||g' -e 's|%||g' | LC_ALL="$EL_LC_EN" grep -E "[[:digit:]]*" | head -1 )"
    fi

    if [[ -n "$volume" ]] ; then
        echo "$volume"
    else
        el_warning "unable to get actual volume with alsa: $( amixer get "$meter" 2>&1 )\namixer scontrols:\n$( amixer scontrols )"
    fi
}

#===  FUNCTION  ================================================================
#          NAME:  set_volume_alsa
#   DESCRIPTION:  set the ALSA volume for the selected meter
#    PARAMETERS:  $1 = volume (80%, 2%+, etc)
#       RETURNS:  true or false if failed
#===============================================================================
set_volume_alsa(){
    local action="$1"
    if [[ "$EL_DEBUG" -gt 2 ]] ; then
        el_check_variables "action|list|meter"
    fi

    if [[ "$list" = *"'$meter',1"* ]] ; then
        # stereo
        amixer -q set "${meter},0" "$action" 2>/dev/null
        amixer -q set "${meter},1" "$action" 2>/dev/null
    else
        # mono
        amixer -q set "$meter" "$action" 2>/dev/null
    fi
}

#===  FUNCTION  ================================================================
#          NAME:  mute_modes_force
#   DESCRIPTION:  force (hack) a mute mode for an unsupported card
#    PARAMETERS:  $1 = mode: muteset|unmute|mute
#       RETURNS:  -
#===============================================================================
mute_modes_force(){
    local mode volume_before volume_actual

    mode="$1"
    if [[ "$EL_DEBUG" -gt 2 ]] ; then
        el_check_variables "mode"
    fi

    case "$audio_subsystem" in
        pipewire)
            case "$mode" in
                muteset)            wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 ;;
                unmute|unmuteset)   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 ;;
                mute|toggle)        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
                *)                  el_error "Unknown $mode option for $FUNCNAME" ;;
            esac
            return 0
            ;;
        pipewire-pulse|pulseaudio)
            if command -v pulsemixer >/dev/null 2>&1 ; then
                case "$mode" in
                    muteset)            pulsemixer --mute ;;
                    unmute|unmuteset)   pulsemixer --unmute ;;
                    mute|toggle)        pulsemixer --toggle-mute ;;
                    *)                  el_error "Unknown $mode option for $FUNCNAME" ;;
                esac
            elif command -v pactl >/dev/null 2>&1 ; then
                case "$mode" in
                    muteset)            pactl set-sink-mute @DEFAULT_SINK@ 1 ;;
                    unmute|unmuteset)   pactl set-sink-mute @DEFAULT_SINK@ 0 ;;
                    mute|toggle)        pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
                    *)                  el_error "Unknown $mode option for $FUNCNAME" ;;
                esac
            fi
            return 0
            ;;
    esac

    # ALSA fallback: emulate mute by saving volume and setting to 0%
    conf_volume_get

    volume_actual="$( get_volume )"
    if [[ -z "$volume_actual" ]] ; then
        exit
    fi

    case "$mode" in
        muteset)
            if [[ "$volume_actual" -gt 20 ]] ; then
                conf_volume_set "$volume_actual"
                el_debug "volume actual was $volume_actual"
            else
                el_debug "no actual volume known"
            fi
            "$0" "0%"
            ;;
        unmute|unmuteset)
            if [[ "$volume_actual" -lt 21 ]] ; then
                if [[ -n "$volume_before" ]] && [[ "$volume_before" -gt 20 ]] ; then
                    "$0" "${volume_before}%"
                else
                    "$0" "defaults"
                fi
            fi
            ;;
        mute|toggle)
            el_debug "volumes was originally at $volume_before and now $volume_actual"
            if [[ "$volume_actual" -lt 21 ]] ; then
                $FUNCNAME unmute
            else
                $FUNCNAME muteset
            fi
            ;;
        *)
            el_error "Unknown $mode option for $FUNCNAME"
            ;;
    esac
}

#===  FUNCTION  ================================================================
#          NAME:  get_mute_state
#   DESCRIPTION:  get whether audio output is muted or unmuted
#    PARAMETERS:  -
#       RETURNS:  muted|unmuted
#===============================================================================
get_mute_state(){
    local state_before raw

    case "$audio_subsystem" in
        pipewire)
            raw="$( LC_ALL=C wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null )"
            if [[ "$raw" = *"[MUTED]"* ]] ; then
                state_before="muted"
            elif [[ -n "$raw" ]] ; then
                state_before="unmuted"
            fi
            ;;
        pipewire-pulse|pulseaudio)
            if command -v pulsemixer >/dev/null 2>&1 ; then
                case "$( pulsemixer --get-mute 2>/dev/null )" in
                    1) state_before="muted" ;;
                    0) state_before="unmuted" ;;
                    *) el_warning "unknown mute state: $( pulsemixer --get-mute 2>&1)" ;;
                esac
            elif command -v pactl >/dev/null 2>&1 ; then
                case "$( LC_ALL=C pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}' )" in
                    yes) state_before="muted" ;;
                    no)  state_before="unmuted" ;;
                esac
            fi
            ;;
        *)
            raw="$( LC_ALL=C amixer get "Master" 2>/dev/null | grep -Po ': .*\[\K(on|off)' | head -1 )"
            case "$raw" in
                off) state_before="muted" ;;
                on)  state_before="unmuted" ;;
            esac
            ;;
    esac

    if [[ -n "$state_before" ]] ; then
        el_debug "mute state was $state_before"
        echo "$state_before"
    fi

    return 0
}

#===  FUNCTION  ================================================================
#          NAME:  mute_modes
#   DESCRIPTION:  set mute or unmute the audio card
#    PARAMETERS:  $1 = mode: mute (toggle), muteset, unmute|unmuteset
#       RETURNS:  -
#===============================================================================
mute_modes(){
    local state_before state_after mode

    mode="$1"
    if [[ "$EL_DEBUG" -gt 2 ]] ; then
        el_check_variables "mode"
    fi

    if [[ "$audio_subsystem" != "alsa" ]] ; then
        case "$mode" in
            unmute|unmuteset) mute_modes_force unmute ;;
            muteset)          mute_modes_force muteset ;;
            mute|toggle)      mute_modes_force toggle ;;
            *)                el_error "Unknown $mode option for $FUNCNAME" ;;
        esac
        return 0
    fi

    state_before="$( get_mute_state )"

    case "$mode" in
        unmute|unmuteset)
            if [[ -n "$state_before" ]] ; then
                if amixer -q set "Master" unmute 2>/dev/null ; then
                    el_debug "audio is now unmuted"
                else
                    mute_modes_force unmute
                    return 0
                fi
            else
                mute_modes_force unmute
                return 0
            fi

            state_after="$( get_mute_state 2>/dev/null )"
            if [[ "$state_after" = "muted" ]] ; then
                el_debug "mute has not changed, forcing unmute"
                mute_modes_force unmute
                return 0
            fi
            ;;
        muteset)
            if [[ -n "$state_before" ]] ; then
                if amixer -q set "Master" mute 2>/dev/null ; then
                    el_debug "audio is now muted"
                else
                    mute_modes_force muteset
                    return 0
                fi
            else
                mute_modes_force muteset
                return 0
            fi

            state_after="$( get_mute_state 2>/dev/null )"
            if [[ "$state_after" = "unmuted" ]] ; then
                el_debug "mute has not changed, forcing muteset"
                mute_modes_force muteset
                return 0
            fi
            ;;
        mute|toggle)
            if [[ -n "$state_before" ]] ; then
                if [[ "$state_before" = "muted" ]] ; then
                    if amixer -q set "Master" unmute 2>/dev/null ; then
                        el_debug "audio is now unmuted"
                    else
                        mute_modes_force unmute
                        return 0
                    fi
                elif [[ "$state_before" = "unmuted" ]] ; then
                    if amixer -q set "Master" mute 2>/dev/null ; then
                        el_debug "audio is now muted"
                    else
                        mute_modes_force muteset
                        return 0
                    fi
                fi
            else
                mute_modes_force toggle
                return 0
            fi

            state_after="$( get_mute_state 2>/dev/null )"
            if [[ "$state_before" = "$state_after" ]] ; then
                el_debug "mute has not changed, forcing toggle"
                mute_modes_force toggle
                return 0
            fi
            ;;
        *)
            el_error "Unknown $mode option for $FUNCNAME"
            ;;
    esac
}

main(){
    local list action audio_subsystem vol_op vol_val volume_mic volume_actual

    if [[ "$1" = "--quiet" ]] ; then
        export is_quiet_mode=1
        shift
    fi

    # Usage
    if [[ -z "${1}" ]] ; then
        echo -e "Usage: $(basename $BASH_SOURCE) args"
        echo -e "\nExamples:"
        echo -e "$(basename $0) defaults  # set volumes generically to optimal ones"
        echo -e "$(basename $0) 80%  # set the volume to the 80 % level"
        echo -e "$(basename $0) 10%+ # increases 10% the actual volume"
        echo -e "$(basename $0) mute    # switch on/off mute mode"
        echo -e "$(basename $0) muteset # set ON mute mode"
        echo -e "$(basename $0) unmute  # set OFF mute mode"
        echo -e "$(basename $0) showvolume  # show the actual volume value"

        echo -e "\n$(basename $0) uses special powers making any card to work with all the features even the mute one, if doesn't, report the bug to us"
        exit 1
    fi

    audio_subsystem="$( el_audio_subsystem_get )"
    [[ "$audio_subsystem" = "none" ]] && audio_subsystem="alsa"
    el_debug "detected audio subsystem: $audio_subsystem"

    case "$audio_subsystem" in
        pipewire)
            if ! el_dependencies_check "wpctl" ; then
                el_dependencies_install "wireplumber"
            fi
            ;;
        pipewire-pulse|pulseaudio)
            if ! command -v pulsemixer >/dev/null 2>&1 && ! command -v pactl >/dev/null 2>&1 ; then
                if ! el_dependencies_check "pulsemixer" ; then
                    el_dependencies_install "pulsemixer"
                fi
            fi
            ;;
        alsa)
            if ! el_dependencies_check "amixer|aplay" ; then
                el_dependencies_install "alsa-utils"
            fi
            ;;
    esac

    conf="$HOME/.config/setvolume"
    action="$*"

    if [[ "$audio_subsystem" = "alsa" ]] ; then
        list="$( amixer scontrols )"
        if [[ -z "$meter" ]] ; then
            get_meter
        fi
        if [[ -z "$meter" ]] ; then
            # refresh controls in case audio-configurator updated .asoundrc
            list="$( amixer scontrols )"
            get_meter
        fi
        el_debug "selected meter: $meter"
    fi

    if [[ "${1}" = "defaults" ]] ; then
        volume_mic=60
        el_audio_alsa_init

        if command -v amixer >/dev/null 2>&1 ; then
            # unmute channels
            amixer -q set Master unmute 2>/dev/null
            amixer -q set PCM    unmute 2>/dev/null
            amixer -q set Front  unmute 2>/dev/null
            amixer -q set Wave   unmute 2>/dev/null
            amixer -q set DAC    unmute 2>/dev/null
            # raise them
            amixer -q set Headphone 50% 2>/dev/null
            amixer -q set Speaker 50% 2>/dev/null
            amixer -q set PCM 50% 2>/dev/null
            amixer -q set Front 50% 2>/dev/null
            amixer -q set Surround 50% 2>/dev/null

            # Mic configurations
            amixer -q set Capture unmute 2>/dev/null
            amixer -q set Capture 100% 2>/dev/null
            amixer -q set "Front Mic" unmute 2>/dev/null
            amixer -q set "Front Mic" ${volume_mic}% 2>/dev/null
            amixer -q set "Rear Mic" unmute 2>/dev/null
            amixer -q set "Rear Mic" ${volume_mic}% 2>/dev/null
            amixer -q set "Internal Mic" unmute 2>/dev/null
            amixer -q set "Internal Mic" ${volume_mic}% 2>/dev/null
            amixer -q set "Mic" unmute 2>/dev/null
            amixer -q set "Mic" ${volume_mic}% 2>/dev/null
            # mute playback of mic (after previous mic configurations since they reset these settings)
            amixer -q sset "Front Mic" Playback mute 2>/dev/null
            amixer -q sset "Rear Mic" Playback mute 2>/dev/null
            amixer -q sset "Internal Mic" Playback mute 2>/dev/null
            amixer -q sset "Mic" Playback mute 2>/dev/null
            # by default do not hear yourself in headphones
            amixer -q set "Sidetone" 0% 2>/dev/null
            # capture mode
            amixer -q sset "Front Mic" cap 2>/dev/null
            amixer -q sset "Rear Mic" cap 2>/dev/null
            amixer -q sset "Internal Mic" cap 2>/dev/null
            amixer -q sset "Mic" cap 2>/dev/null
            amixer -q sset Capture cap 2>/dev/null
            amixer -q set Capture ${volume_mic}% 2>/dev/null

            # volumes up, just in case
            amixer -q set Headphone 100% 2>/dev/null
            amixer -q set Speaker 100% 2>/dev/null
            amixer -q set PCM 100% 2>/dev/null
            amixer -q set Front 100% 2>/dev/null
            amixer -q set Surround 100% 2>/dev/null

            # Master should be always set to 100 % in order to avoid distortions
            el_debug "Master set to 100%"
            amixer -q set "Master Mono" 100%  2>/dev/null
            amixer -q set Master,0 100%  2>/dev/null
            amixer -q set Master,1 100%  2>/dev/null
            amixer -q set Master 100%  2>/dev/null
        fi

        if [[ "$audio_subsystem" = "alsa" ]] ; then
            unset meter
            main 70% 1>/dev/null
            main 2%+ 1>/dev/null
            conf_volume_set
        else
            mute_modes "unmute"
            main 70% 1>/dev/null
        fi

        exit 0
    fi

    # fixes percent space and keybinding word aliases
    action="${action/ %/%}"
    action="${action/ up/+}"
    action="${action/ down/-}"

    # MUTE modes and status
    case "$action" in
        muteset)
            mute_modes "muteset"
            exit 0
            ;;
        unmute)
            mute_modes "unmute"
            exit 0
            ;;
        mute)
            mute_modes "mute"
            exit 0
            ;;
        showvolume)
            get_volume
            exit 0
            ;;
    esac

    # Parse volume operation and value (e.g., 80%, 10%+, 10%-, +10, -10)
    vol_val="${action//[^[:digit:]]/}"
    if [[ -z "$vol_val" ]] ; then
        el_error "Unknown volume argument '$action'"
        exit 1
    fi
    case "$action" in
        *"+"*) vol_op="inc" ;;
        *"-"*) vol_op="dec" ;;
        *)     vol_op="set" ;;
    esac

    case "$audio_subsystem" in
        pipewire)
            case "$vol_op" in
                set) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${vol_val}%" ;;
                inc) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${vol_val}%+" ;;
                dec) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${vol_val}%-" ;;
            esac
            ;;
        pipewire-pulse|pulseaudio)
            if command -v pulsemixer >/dev/null 2>&1 ; then
                case "$vol_op" in
                    set) pulsemixer --set-volume "$vol_val" ;;
                    inc) pulsemixer --change-volume "+${vol_val}" ;;
                    dec) pulsemixer --change-volume "-${vol_val}" ;;
                esac
            elif command -v pactl >/dev/null 2>&1 ; then
                case "$vol_op" in
                    set) pactl set-sink-volume @DEFAULT_SINK@ "${vol_val}%" ;;
                    inc) pactl set-sink-volume @DEFAULT_SINK@ "+${vol_val}%" ;;
                    dec) pactl set-sink-volume @DEFAULT_SINK@ "-${vol_val}%" ;;
                esac
            fi
            ;;
        alsa)
            case "$vol_op" in
                set) action="${vol_val}%" ;;
                inc) action="${vol_val}%+" ;;
                dec) action="${vol_val}%-" ;;
            esac

            amixer -q set "$meter" "$action" 2>/dev/null
            [[ "${meter}" != "Speaker" ]]   && amixer -q set Speaker "$action" 2>/dev/null
            [[ "${meter}" != "Headphone" ]] && amixer -q set Headphone "$action" 2>/dev/null
            [[ "${meter}" != "DAC" ]]       && amixer -q set DAC "$action" 2>/dev/null

            volume_actual="$( get_volume )"
            if [[ "$vol_op" = "inc" ]] && [[ "${volume_actual}" = "100" ]] ; then
                amixer -q set Master "$action" 2>/dev/null
            fi

            conf_volume_set "$volume_actual"
            ;;
    esac

    true
}

#
#  MAIN
#
main "$@"

# vim: set foldmethod=marker :
